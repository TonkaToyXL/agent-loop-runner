{
  "name": "agent-loop-runner",
  "version": "1.0.0",
  "description": "Relay: one hub to run Grok, Muse, Hermes and other agents together, plus the PR Babysit loop.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "setup:mac": "bash scripts/setup-mac.sh",
    "hub": "tsx src/hub/main.ts",
    "setup:hermes": "bash scripts/setup-hermes.sh",
    "setup:telegram": "bash scripts/setup-telegram.sh",
    "setup:grok": "bash scripts/setup-grok.sh",
    "setup:clinepass": "bash scripts/setup-clinepass.sh",
    "setup:antigravity": "bash scripts/setup-antigravity.sh",
    "babysit-pr": "tsx src/babysit-pr.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "bin": {
    "babysit-pr": "./src/babysit-pr.ts"
  },
  "keywords": [
    "cursor",
    "ai-agent",
    "github",
    "cli",
    "pr-automation",
    "typescript",
    "multi-agent",
    "dashboard",
    "telegram",
    "imessage"
  ],
  "author": "TonkaToyXL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TonkaToyXL/agent-loop-runner.git"
  },
  "bugs": {
    "url": "https://github.com/TonkaToyXL/agent-loop-runner/issues"
  },
  "homepage": "https://github.com/TonkaToyXL/agent-loop-runner#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
