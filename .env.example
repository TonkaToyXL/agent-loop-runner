# Relay hub settings. Copy to .env and fill in what you use. Never commit .env.

# ---- Hub
PORT=4747
HOST=127.0.0.1
# Required if HOST is not 127.0.0.1. Any long random string; the dashboard asks for it once.
HUB_TOKEN=
# Public URL agents can reach for webhook callbacks (only needed for webhook agents on other machines).
RELAY_PUBLIC_URL=

# ---- Grok (pick one)
# xAI API key from console.x.ai
XAI_API_KEY=
# or: your Grok Bot routine's webhook trigger URL + key
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=

# ---- Muse (Muse Spark via Meta's Model API; use the OpenAI-compatible base URL from Meta's docs)
MUSE_BASE_URL=
MUSE_API_KEY=

# ---- Hermes Agent: run `npm run setup:hermes` to fill these in automatically
# Usually http://127.0.0.1:8642/v1 (leave blank to keep Hermes in demo mode)
HERMES_BASE_URL=
# Must match API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=

# ---- Telegram (talk to @BotFather, /newbot)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to command the crew. Message the bot once and it replies with your id.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- iMessage via BlueBubbles (runs on a Mac signed in to Messages)
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# Phone numbers / emails allowed to command the crew, comma-separated (e.g. +15125550100)
IMESSAGE_ALLOWED_HANDLES=
# Any long random string. BlueBubbles webhook URL: <RELAY_PUBLIC_URL>/hooks/imessage?token=<this>
IMESSAGE_HOOK_TOKEN=
