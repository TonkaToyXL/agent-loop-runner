# Relay hub settings. Copy to .env and fill in what you use. Never commit .env.

# ---- Hub
PORT=4747
HOST=127.0.0.1
# Required if HOST is not 127.0.0.1. Any long random string; the dashboard asks for it once.
HUB_TOKEN=
# Public URL agents can reach for webhook callbacks (only needed for webhook agents on other machines).
RELAY_PUBLIC_URL=

# Pay-per-use APIs (xAI, Meta Model API) are blocked unless this is true.
RELAY_ALLOW_METERED=false

# ---- Grok: your Grok Bot routine's webhook (runs on your Grok subscription). `npm run setup:grok` fills these in.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
# Header that carries the key, if not "Authorization: Bearer" (e.g. X-Webhook-Key)
GROK_WEBHOOK_HEADER=
# Optional pay-per-use fallback (needs RELAY_ALLOW_METERED=true)
XAI_API_KEY=

# ---- ClinePass ($9.99/mo flat): powers Muse and the Cline agent. `npm run setup:clinepass` fills this in.
# Key from app.cline.bot → Settings → API Keys. Relay only sends cline-pass/ models on it.
CLINEPASS_API_KEY=

# ---- Gemini from your Google AI Pro plan via Google's Antigravity CLI (agy). Off until you opt in.
# `npm run setup:antigravity` explains the terms question and turns this on.
ANTIGRAVITY_ENABLED=false

# ---- Muse direct via Meta's pay-per-use Model API (only used if RELAY_ALLOW_METERED=true)
MUSE_BASE_URL=
MUSE_API_KEY=

# ---- Hermes Agent: run `npm run setup:hermes` to fill these in automatically
# Usually http://127.0.0.1:8642/v1 (leave blank to keep Hermes in demo mode)
HERMES_BASE_URL=
# Must match API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=

# ---- Email, read-only over IMAP with an app password. `npm run setup:email` fills these in.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
# Which text-only agent may read mail to summarize it: gemini, muse, cline, or none
MAIL_SUMMARIZER=none

# ---- Telegram (talk to @BotFather, /newbot)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to command the crew. Message the bot once and it replies with your id.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- iMessage via BlueBubbles (runs on a Mac signed in to Messages)
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# Phone numbers / emails allowed to command the crew, comma-separated (e.g. +15125550100)
IMESSAGE_ALLOWED_HANDLES=
# Any long random string. BlueBubbles webhook URL: <RELAY_PUBLIC_URL>/hooks/imessage?token=<this>
IMESSAGE_HOOK_TOKEN=
